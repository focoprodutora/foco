# Copie este arquivo para .env e preencha.

# ---------- Básico ----------
PORTA=3000
NOME_NEGOCIO=Foco Mentoria
# Senha para abrir o painel no navegador
PAINEL_SENHA=troque-esta-senha
# Números da equipe, com DDD, separados por vírgula.
# Mensagens desses números viram comandos para a secretária; os demais vão para o suporte.
NUMEROS_EQUIPE=31999990000,11988880000

# ---------- IA (Claude) ----------
# Crie a chave em https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# CLAUDE_ESFORCO=medium

# ---------- Transcrição de áudio (Whisper) ----------
# OpenAI: https://platform.openai.com/api-keys
TRANSCRICAO_CHAVE=
# TRANSCRICAO_URL=https://api.openai.com/v1
# TRANSCRICAO_MODELO=whisper-1
# Alternativa mais barata (Groq):
# TRANSCRICAO_URL=https://api.groq.com/openai/v1
# TRANSCRICAO_MODELO=whisper-large-v3-turbo

# ---------- WhatsApp (Evolution API) ----------
# Endereço da Evolution API (no docker-compose já é preenchido sozinho)
EVOLUTION_URL=https://sua-evolution-api.com
# A chave da Evolution (variável AUTHENTICATION_API_KEY dela). Invente uma senha longa se for você que vai subir a Evolution.
EVOLUTION_CHAVE=
# Nome da conexão dentro da Evolution (qualquer nome, sem espaços)
EVOLUTION_INSTANCIA=secretaria
# Endereço público desta aplicação, para a Evolution entregar as mensagens.
# No Railway é preenchido sozinho; no docker-compose também.
URL_PUBLICA=https://sua-secretaria.com
# Senha que protege a entrada das mensagens (invente uma senha longa)
WEBHOOK_TOKEN=troque-este-token
# Só para o docker-compose: senha do banco interno da Evolution
POSTGRES_SENHA=troque-esta-senha

# ---------- Suporte e rotinas ----------
# Segundos de espera para juntar mensagens picadas antes de responder
SUPORTE_AGUARDAR_SEGUNDOS=20
# Avisar a equipe quando um atendimento ficar sem resposta por mais de X horas
ALERTA_TICKET_HORAS=2
# Hora do resumo diário no WhatsApp da equipe (-1 desliga)
RESUMO_DIARIO_HORA=7
